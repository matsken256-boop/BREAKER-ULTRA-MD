const fs=require('fs');const path=require('path');const settings=require('../../settings');
module.exports=(sock)=>{
  sock.ev.on('messages.upsert',async({messages})=>{
    const m=messages[0];if(!m.message||m.key.fromMe)return;
    const body=m.message.conversation||m.message.extendedTextMessage?.text||m.message.imageMessage?.caption||"";
    if(!body.startsWith(settings.prefix))return;
    const args=body.slice(settings.prefix.length).trim().split(/ +/);
    const cmd=args.shift().toLowerCase();
    const file=path.join(__dirname,'..','Plugins',cmd+'.js');
    if(fs.existsSync(file)){try{const p=require(file);await p.execute(sock,m,args,settings)}catch(e){console.log(e)}}
  });
};
