module.exports = {
    runtime: (sec) => {
        sec = Number(sec);
        let d = Math.floor(sec / (3600*24));
        let h = Math.floor(sec % (3600*24) / 3600);
        let m = Math.floor(sec % 3600 / 60);
        let s = Math.floor(sec % 60);
        return `${d}d ${h}h ${m}m ${s}s`;
    },
    isOwner: (jid, ownerNumber) => {
        return jid.includes(ownerNumber);
    }
};